#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Desktop policy of the Alpine XFCE image. build-all.sh runs it once as root in
# the image root after the desktop packages are installed. README.md beside
# this script owns the contract.
set -eu

# Xorg finds and classifies input devices through udev, so eudev replaces the
# minimal image's mdevd. OpenRC counts UML among containers and would skip
# udev's coldplug there; this UML owns its devtmpfs and virtual hardware.
rc-update del mdevd-init sysinit
rc-update del mdevd sysinit
for service in udev udev-trigger udev-settle; do
	sed -i '/^[[:space:]]*keyword -containers[[:space:]]*$/d' \
		"/etc/init.d/$service"
	rc-update add "$service" sysinit
done
rc-update add udev-postmount default
for service in dbus elogind lightdm; do
	rc-update add "$service" default
done

install -d -m 0755 /etc/udev/rules.d
cat > /etc/udev/rules.d/59-kernarium-input.rules <<'RULES'
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Kernarium Touchscreen", ENV{ID_INPUT}="1", ENV{ID_INPUT_TOUCHSCREEN}="1"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Kernarium Keyboard", ENV{ID_INPUT}="1", ENV{ID_INPUT_KEYBOARD}="1"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Darwin UML VNC Keyboard", ENV{ID_INPUT}="1", ENV{ID_INPUT_KEYBOARD}="1"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Darwin UML VNC Tablet", ENV{ID_INPUT}="1", ENV{ID_INPUT_MOUSE}="1"
RULES
chmod 0644 /etc/udev/rules.d/59-kernarium-input.rules

adduser -D -s /bin/sh uml
passwd -d uml
# The user is the image's owner; root stays locked.
printf '%s\n' 'permit nopass uml' > /etc/doas.d/kernarium.conf
chmod 0600 /etc/doas.d/kernarium.conf
for group in video input audio render; do
	if getent group "$group" >/dev/null; then
		addgroup uml "$group"
	fi
done

install -d -m 0755 /etc/lightdm/lightdm.conf.d
printf '%s\n' '[Seat:*]' 'autologin-user=uml' 'autologin-session=xfce' \
	'user-session=xfce' > /etc/lightdm/lightdm.conf.d/50-kernarium.conf
[ -f /usr/share/xsessions/xfce.desktop ] || {
	echo "alpine-xfce setup: the image has no XFCE session" >&2
	exit 1
}

# Kernarium mounts the image read-only beneath a fresh overlay from its own
# /init, so the image mounts no root of its own.
printf '%s\n' '# The root is the overlay the per-run /init mounts.' > /etc/fstab
printf '%s\n' alpine-xfce > /etc/hostname
